# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Test Environment
ENVIRONMENT=DEMO

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=testuser
DB_PASSWORD=testpass
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# API Configuration
API_BASE_URL=http://localhost:3000
MOCK_API_URL=http://localhost:3000
PUBLIC_API_URL=https://jsonplaceholder.typicode.com

# Playwright Configuration
HEADLESS=true
BROWSER=chromium
TIMEOUT=30000

# CI/CD Flags
CI=false
PARALLEL_WORKERS=4

# Reporting
REPORT_OUTPUT=./test-results/

# MCP Configuration (Model Context Protocol)
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8080
MCP_API_KEY=

# Test Agents Configuration
AGENTS_ENABLED=false
AGENT_MODEL=claude-3-sonnet
AGENT_ENDPOINT=

# Docker Configuration
DOCKER_DB_HOST=postgres
DOCKER_API_HOST=mock-api
